      <aliases enabled="yes"/>
      <column caption="Body Temp" datatype="real" name="[BodyTemp]" role="measure" type="quantitative"/>
      <column caption="High risk flag" datatype="string" name="[Calculation_1932114620339281920]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF [Age] &lt; 25 THEN &quot;Under 25&quot;&#10;ELSEIF [Age] &gt;= 25 AND [Age] &lt; 35 THEN &quot;25–34&quot;&#10;ELSE &quot;35+&quot;&#10;END"/>
      </column>
      <column caption="Calculation1" datatype="string" name="[Calculation_1932114620410429447]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF [Age] &lt; 25 THEN &quot;&lt;25&quot;&#10;ELSEIF [Age] &gt;= 25 AND [Age] &lt; 35 THEN &quot;25–34&quot;&#10;ELSE &quot;35+&quot;&#10;END"/>
      </column>
      <column caption="Calculation2" datatype="string" name="[Calculation_1932114620410556424]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF [RiskLevel] = &quot;high risk&quot; THEN &quot;High risk&quot;&#10;ELSE &quot;Low/Mid risk&quot;&#10;END"/>
      </column>
      <column caption="Simple Risk score" datatype="integer" name="[Calculation_1932114620410761225]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF [SystolicBP] &gt;= 140 THEN 2 ELSE 0 END&#10;+&#10;IF [BS] &gt;= 10 THEN 2 ELSE 0 END&#10;+&#10;IF [Age] &gt;= 35 THEN 1 ELSE 0 END&#10;+&#10;IF [HeartRate] &gt;= 100 THEN 1 ELSE 0 END"/>
      </column>
      <column caption="Calculation3" datatype="integer" name="[Calculation_1932114620416929803]" role="measure" type="quantitative">
        <calculation class="tableau" formula="1"/>
      </column>
      <column caption="Number of records" datatype="integer" name="[Calculation_1932114620417363980]" role="measure" type="quantitative">
        <calculation class="tableau" formula="1"/>
      </column>
      <column caption="Risk by age group" datatype="string" name="[Calculation_1932114620420632590]" role="dimension" type="nominal">
